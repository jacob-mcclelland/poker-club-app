rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event images are public to read, but uploads require a signed-in user.
    match /event-images/{filename} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Announcement images are public to read, but uploads require a signed-in user.
    match /announcements/{filename} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
